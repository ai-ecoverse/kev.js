{
  "name": "@ai-ecoverse/kev.js",
  "version": "0.6.0",
  "description": "Kev decision models in the browser: WebGPU/WASM via onnxruntime-web, TypeSafe System One API",
  "keywords": [
    "kev",
    "jev",
    "typesafe",
    "system-one",
    "decision-model",
    "onnxruntime",
    "webgpu",
    "qwen3.5",
    "classification",
    "calibration"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/kev.js.git"
  },
  "homepage": "https://ai-ecoverse.github.io/kev.js/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:lib": "tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "fetch-model": "node --import tsx scripts/fetch-model.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.2.0"
  },
  "peerDependencies": {
    "onnxruntime-common": ">=1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.0.0",
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "^1.30.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.9"
  }
}
